{
  "id": "/",
  "name": "Smart Bin Recognition",
  "short_name": "Which Bin.",
  "description": "Point your phone at a bin. It tells you what goes in it, in your language, wherever you are.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "background_color": "#FCFBF8",
  "theme_color": "#5B2E91",
  "lang": "en",
  "dir": "auto",
  "categories": ["utilities", "education", "lifestyle"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "/icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/icon-mono-512.png", "sizes": "512x512", "type": "image/png", "purpose": "monochrome" }
  ],
  "shortcuts": [
    {
      "name": "Search the rules",
      "short_name": "Rules",
      "description": "Look up an item without a camera. Works offline.",
      "url": "/rules",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
