{
  "name": "smart-bin-recognition-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:shots": "playwright test e2e/shots.spec.ts",
    "check:locales": "node scripts/check-locales.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "build:icons": "node scripts/build-icons.mjs",
    "emit:fixtures": "node scripts/emit-wire-fixtures.mjs",
    "verify": "npm run typecheck && npm test && npm run check:locales && npm run build && npm run check:bundle"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^3.2.7"
  }
}
