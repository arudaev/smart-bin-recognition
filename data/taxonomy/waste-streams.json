{
  "$schema": "./waste-streams.schema.json",
  "version": "1.0.0",
  "updated": "2026-08-01",
  "description": "Canonical, jurisdiction-independent waste-stream ontology. Stream ids are stable identifiers and MUST NOT be renamed once published; regions map local reality onto these ids. All human-readable text is referenced by i18n key and lives in web/src/i18n/<locale>.json.",

  "colors": [
    { "id": "blue",        "hex_ref": "#1F4FA8" },
    { "id": "green",       "hex_ref": "#1E7A3C" },
    { "id": "brown",       "hex_ref": "#6B4423" },
    { "id": "black",       "hex_ref": "#1A1A1A" },
    { "id": "grey",        "hex_ref": "#8A8A8A" },
    { "id": "yellow",      "hex_ref": "#F2C200" },
    { "id": "orange",      "hex_ref": "#E8720C" },
    { "id": "red",         "hex_ref": "#C1272D" },
    { "id": "white",       "hex_ref": "#F2F2F2" },
    { "id": "transparent", "hex_ref": null },
    { "id": "metal",       "hex_ref": "#9BA3A8" }
  ],

  "form_factors": [
    { "id": "wheelie_small",  "i18n_key": "form.wheelie_small",  "capacity_l": [80, 240],   "note": "Two-wheel household bin. Lid colour is usually the semantic signal; body is often black or grey." },
    { "id": "wheelie_large",  "i18n_key": "form.wheelie_large",  "capacity_l": [660, 1100], "note": "Four-wheel communal container, typical of apartment blocks." },
    { "id": "igloo",          "i18n_key": "form.igloo",          "capacity_l": [1500, 3000], "note": "Bottle-bank / igloo. Apertures may be separately coloured – see aperture detection, v2." },
    { "id": "underground",    "i18n_key": "form.underground",    "capacity_l": [3000, 5000], "note": "Underground container; only the drop column is visible." },
    { "id": "textile_bank",   "i18n_key": "form.textile_bank",   "capacity_l": null,        "note": "Clothing/shoe donation container. Often operator-branded rather than colour-coded." },
    { "id": "street_basket",  "i18n_key": "form.street_basket",  "capacity_l": [30, 120],   "note": "Public litter basket. Almost always residual; never a sorting target." },
    { "id": "sack",           "i18n_key": "form.sack",           "capacity_l": null,        "note": "Kerbside sack, e.g. Gelber Sack. Colour is the whole signal." },
    { "id": "crate",          "i18n_key": "form.crate",          "capacity_l": [20, 90],    "note": "Open crate or box, e.g. paper crates in some regions." },
    { "id": "wall_unit",      "i18n_key": "form.wall_unit",      "capacity_l": null,        "note": "In-store or wall-mounted collection box: batteries, small e-waste, bulbs." },
    { "id": "container_bank", "i18n_key": "form.container_bank", "capacity_l": null,        "note": "Group detection: a row of three or more containers. Resolves to a list of child bins, not a single stream." }
  ],

  "families": [
    { "id": "residual",    "i18n_key": "family.residual" },
    { "id": "recyclable",  "i18n_key": "family.recyclable" },
    { "id": "organic",     "i18n_key": "family.organic" },
    { "id": "special",     "i18n_key": "family.special" },
    { "id": "reuse",       "i18n_key": "family.reuse" },
    { "id": "meta",        "i18n_key": "family.meta" }
  ],

