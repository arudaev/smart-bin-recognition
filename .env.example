# Copy to .env (gitignored). See AGENTS.md > External Resources.

# Hugging Face – dataset + model artefacts. Read + write on arudaev/* repos.
HF_TOKEN=

# Kaggle – must be a KGAT_... token (Kaggle CLI >= 1.8.0). Used by dispatch.py.
KAGGLE_API_TOKEN=

# GitHub – CI status, workflow triggers.
GITHUB_TOKEN=

# --- web/ runtime (Vercel project env, not needed for the ML side) ---
# Cloudflare Turnstile – bot protection on writes. Free, unlimited.
TURNSTILE_SECRET_KEY=
# Supabase – registry Postgres + PostGIS.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Stage-3 escalation vision model.
ANTHROPIC_API_KEY=
# Hard project-wide daily ceiling on escalations. See docs/05-cost-model.md.
SBR_ESCALATION_DAILY_CAP=100
