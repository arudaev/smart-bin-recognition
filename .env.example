# Copy to .env (gitignored). See AGENTS.md > External Resources.
#
# Nothing here is needed to run the web client: with no service configured it
# uses the in-process mock and the settings screen says so. These are for the
# ML side, and for the phases that have not landed yet.

# --- ML pipeline (phase 2) ---------------------------------------------------

# Hugging Face – dataset + model artefacts. Read + write on arudaev/*.
# Get one: https://huggingface.co/settings/tokens  ("Write" role, or a
# fine-grained token with write on arudaev/smart-bin-detect)
HF_TOKEN=

# Kaggle – GPU training runs. Must be a KGAT_... token (Kaggle CLI >= 1.8.0),
# not the legacy kaggle.json key. Used by ml/scripts/dispatch.py.
# Get one: https://www.kaggle.com/settings  > API > "Create New Token"
# Phone verification is required before a Kaggle account can use GPU or
# internet in a kernel: https://www.kaggle.com/settings > Phone Verification
KAGGLE_API_TOKEN=

# GitHub – CI status, workflow triggers. Scopes: repo, workflow.
# Get one: https://github.com/settings/tokens  (classic) or
#          https://github.com/settings/personal-access-tokens (fine-grained)
GITHUB_TOKEN=

# --- web/ runtime (Vercel project env, not needed for the ML side) -----------

# Cloudflare Turnstile – bot protection on writes. Free, unlimited.
# Get one: https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SECRET_KEY=

# Supabase – registry Postgres + PostGIS (phase 4).
# Get both: https://supabase.com/dashboard/project/_/settings/api
# SUPABASE_SERVICE_KEY is the service_role key. It bypasses row-level security,
# so it belongs on the server and never in anything Vite builds.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Stage-3 escalation vision model (phase 5).
# Get one: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Hard project-wide daily ceiling on escalations. See docs/05-cost-model.md.
SBR_ESCALATION_DAILY_CAP=100

# --- pointing the client at a service ----------------------------------------
#
# These are NOT read from this file. Vite only loads env from web/, and only
# names starting with VITE_ reach the bundle. For local development put them in
# web/.env.local; for production set them in the Vercel project.
#
#   web/.env.local
#     VITE_DETECT_WS=ws://localhost:7860/stream    live streaming scan
#     VITE_DETECT_URL=http://localhost:7860/detect one frame per request
#
# With neither set the client uses the in-process mock and names it honestly on
# the settings screen.
